# Copy this file to .env and fill in your keys. .env is git-ignored: never commit real keys.

# Groq LLM: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any Groq model that supports tool calling
GROQ_MODEL=openai/gpt-oss-120b

# SerpAPI (Google search): https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# LangSmith tracing + Studio: https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=week2-search-agent

# SQL Server for the data agent (same as Week 1; defaults shown)
# MSSQL_SERVER=localhost
# MSSQL_DATABASE=week1_ai
